{
  "$description": "Source unique des jetons. Valeurs issues de DESIGN-AUDIT.md (2026-10-11). Les jetons marqués derive:true sont calculés par build.mjs pour atteindre la cible WCAG.",
  "meta": {
    "name": "ds",
    "version": "2.0.0-draft"
  },
  "a11y": {
    "textRatio": 4.5,
    "largeTextRatio": 3,
    "uiRatio": 3
  },
  "primitive": {
    "color": {
      "black-950": "#0a0a0a",
      "ink-900": "#1a1a1a",
      "gray-800": "#262626",
      "white-50": "#fafafa",
      "white-100": "#f5f5f5",
      "white": "#ffffff",
      "parchment-300": "#e3dacb",
      "parchment-400": "#d4cec4",
      "parchment-50": "#f5f2eb",
      "navy-900": "#03094a",
      "navy-700": "#1e1e3a",
      "charcoal-900": "#1e1e1e",
      "lime-400": "#c8ff00",
      "ruby-600": "#c41e3a",
      "violet-400": "#818cf8",
      "violet-600": "#6e56f8",
      "teal-500": "#00b8a9",
      "blue-600": "#155dfc",
      "blue-400": "#60a5fa",
      "purple-600": "#9810fa",
      "purple-400": "#a78bfa",
      "green-400": "#05df72",
      "red-400": "#ff6568"
    },
    "neutralRamp": {
      "$comment": "Rampe OKLCH de l'audit (--ds-n-100..900). Passée telle quelle au CSS, non utilisée dans les calculs de contraste.",
      "100": "oklch(0.98 0 0)",
      "200": "oklch(0.92 0 0)",
      "300": "oklch(0.84 0 0)",
      "400": "oklch(0.72 0 0)",
      "500": "oklch(0.60 0 0)",
      "600": "oklch(0.48 0 0)",
      "700": "oklch(0.36 0 0)",
      "800": "oklch(0.24 0 0)",
      "900": "oklch(0.14 0 0)"
    },
    "alpha": {
      "$comment": "Proposition de consolidation (14 niveaux trouvés -> 5). À valider visuellement.",
      "white": { "8": 0.08, "15": 0.15, "30": 0.3, "50": 0.5, "70": 0.7 },
      "black": { "35": 0.35, "50": 0.5, "60": 0.6, "85": 0.85 }
    }
  },
  "theme": {
    "studio": {
      "label": "Studio",
      "bg": "{primitive.color.black-950}",
      "fg": "{primitive.color.white-50}",
      "accent": "{primitive.color.lime-400}",
      "muted": "{primitive.color.gray-800}",
      "accentAlt": "{primitive.color.lime-400}",
      "accentAltFg": "{primitive.color.black-950}",
      "btnRadius": "0px",
      "fontKicker": "mono",
      "ctaBg": "{theme.studio.accent}",
      "ctaFg": "{theme.studio.bg}"
    },
    "book": {
      "label": "Book",
      "bg": "{primitive.color.parchment-300}",
      "fg": "{primitive.color.ink-900}",
      "accent": "{primitive.color.ink-900}",
      "muted": "{primitive.color.parchment-400}",
      "accentAlt": "{primitive.color.ruby-600}",
      "accentAltFg": "{primitive.color.parchment-50}",
      "btnRadius": "0px",
      "fontKicker": "typewriter",
      "ctaBg": "{theme.book.accentAlt}",
      "ctaFg": "{theme.book.accentAltFg}",
      "ctaGlow": "{theme.book.accentAlt}"
    },
    "mood": {
      "label": "Mood",
      "bg": "{primitive.color.navy-900}",
      "bgEdge": "{primitive.color.charcoal-900}",
      "fg": "{primitive.color.white-100}",
      "accent": "{primitive.color.violet-400}",
      "muted": "{primitive.color.navy-700}",
      "accentAlt": "{primitive.color.violet-400}",
      "accentAltFg": "{primitive.color.navy-900}",
      "btnRadius": "999px",
      "fontKicker": "mono",
      "gradient": ["{primitive.color.blue-600}", "{primitive.color.purple-600}"],
      "gradientText": ["{primitive.color.blue-400}", "{primitive.color.purple-400}"],
      "ctaBg": "{theme.mood.gradient}",
      "ctaFg": "{primitive.color.white}",
      "ctaGlow": "{theme.mood.accent}"
    }
  },
  "state": {
    "success": "{primitive.color.green-400}",
    "error": "{primitive.color.red-400}"
  },
  "brand": {
    "panel": "{primitive.color.violet-600}",
    "pairDev": "{primitive.color.teal-500}"
  },
  "font": {
    "family": {
      "sans": "'Geist', 'Geist Fallback', system-ui, sans-serif",
      "mono": "'Geist Mono', 'Geist Mono Fallback', ui-monospace, monospace",
      "serif-accent": "'Playfair Display', Georgia, serif",
      "typewriter": "'Special Elite', 'Courier New', monospace",
      "fantasy": "'IM Fell English', Georgia, serif",
      "display-mood": "'Syne', 'Geist', sans-serif"
    },
    "weight": { "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "size": {
      "$comment": "px. 8 et 9 retirés (illisibles). 10 réservé aux chips.",
      "10": 10, "11": 11, "12": 12, "14": 14, "16": 16, "20": 20,
      "24": 24, "30": 30, "36": 36, "48": 48, "60": 60, "72": 72, "96": 96
    },
    "sizeFluid": {
      "$comment": "Valeurs exactes trouvées dans l'audit (studio-section.tsx:327, :365, book-section.tsx:324). Breakpoints: base / md / lg.",
      "hero-studio": { "base": "12vw", "md": "10vw", "lg": "9vw" },
      "display": { "base": "6vw", "md": "5vw" },
      "marquee": { "base": "8vw" },
      "hero-book": { "base": "clamp(2.5rem, 7vw, 6.5rem)" }
    },
    "lineHeight": {
      "stacked": 0.5,
      "display": 0.9,
      "tight": 1.05,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.625
    },
    "letterSpacing": {
      "tighter": "-0.05em",
      "tight": "-0.025em",
      "normal": "0em",
      "wide": "0.05em",
      "wider": "0.12em",
      "widest": "0.2em",
      "kicker": "0.3em"
    }
  },
  "space": {
    "$comment": "px, base 4. Mêmes numéros que Tailwind (1=4px).",
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32,
    "12": 48, "16": 64, "20": 80, "24": 96
  },
  "radius": {
    "none": "0px", "sm": "8px", "md": "16px", "lg": "28px", "full": "999px"
  },
  "border": {
    "hairline": "1px", "control": "1.5px", "focus": "2px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,.4)",
    "md": "0 8px 24px rgba(0,0,0,.45)",
    "lg": "0 24px 60px rgba(0,0,0,.55)",
    "glow-soft": "0 0 15px rgba(255,255,255,.1)",
    "glow-strong": "0 0 25px rgba(255,255,255,.25)"
  },
  "motion": {
    "ease": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": {
      "quick": 200, "fast": 300, "hover": 500, "base": 900, "slow": 1200
    }
  },
  "focus": {
    "$comment": "Anneau de focus: 2px, couleur = accent du thème, offset 3px. Contraste >= 3:1 vérifié par le build.",
    "width": "2px",
    "offset": "3px"
  }
}
